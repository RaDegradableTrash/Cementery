  m_text: "Credits\n\n==================================================\r\n              
    DEVELOPMENT CREDITS\r\n==================================================\r\n\r\n[
    CORE SYSTEMS & DEVELOPMENT ]\r\n\r\nLEAD PROGRAMMERS\r\nRagon / Woody\r\n\r\nPROJECT
    ARCHITECT & BUILD\r\nRagon\r\n\r\nWEBGL TECH COORDINATOR\r\nRagon\r\n\r\nDYNAMIC
    LIGHTING SYSTEM\r\nRagon\r\n\r\n443-CHUNK TERRAIN ARTIST\r\nRagon\r\n\r\nGAME
    MECHANICS DESIGNER\r\nRagon\r\n\r\nINTERACTION DESIGNER\r\nRagon\r\n\r\n--------------------------------------------------\r\n\r\n[
    ART & VEHICLE ENGINEERING ]\r\n\r\n3D HARD-SURFACE ARTIST\r\nWoody\r\n\r\nVEHICLE
    PHYSICS & CONTROL\r\nWoody\r\n\r\nAUDIO & SOUND DESIGNER\r\nWoody\r\n\nUSER INTERFACE
    DESIGNER\r\nWoody\r\n\r\n--------------------------------------------\r\n\r\r\n[
    PRODUCTION TOOLS & INFRASTRUCTURE ]\r\n\r\nCODE EDITING SUPPORT\r\nVisual Studio
    Code\r\n\r\nREMOTE COLLABORATION & VERSION CONTROL\r\nGit / GitHub\r\n\r\r\n--------------------------------------------------\r\n\r\n[
    EXTERNAL SUPPORT ]\r\n\nSPECIAL THANKS\r\nYinan\r\n\r\nPOWERED BY\r\nUnity Engine\r\n\r\n================================================\nNO
    AUTOMATED CODE WAS HARMED IN THE MAKING OF THIS PROJECT."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
